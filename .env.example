# Copy to .env and fill in. Never commit .env.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=
ANTHROPIC_API_KEY=

# LinkedIn / Naukri alert emails (optional). Read-only IMAP access to your inbox.
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
IMAP_USER=
IMAP_PASSWORD=
# IMAP_HOST=imap.gmail.com

# LinkedIn / Naukri / Indeed listings via Google for Jobs (JSearch on RapidAPI, free tier).
# Sign up at https://rapidapi.com -> search "JSearch" -> subscribe to the free Basic plan -> copy your key.
JSEARCH_KEY=
